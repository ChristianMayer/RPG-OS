{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rpg-os.invalid/schemas/ruleset.schema.json",
  "title": "RPG-OS Ruleset",
  "description": "Schema for a RPG-OS ruleset file. The ruleset defines the schema (rules) of one game system; the engine resolves them in universal (dynamic) mode or via generated (specific) code. Every ruleset must state its licence and may carry an optional comment. Numeric data values may be expressed as a plain integer, a dice expression string (e.g. \"2d6+1\"), or a range object {\"min\": ..., \"max\": ...}; the engine picks such values per a requested variance (weakest / weak / average / strong / strongest / random).",
  "type": "object",
  "required": ["schema_version", "ruleset_id", "licence", "attributes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of this schema. Currently always 1."
    },
    "ruleset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "description": "Machine identifier of the ruleset (e.g. 'dnd5e_srd')."
    },
    "ruleset_name": { "type": "string", "description": "Human-readable ruleset name." },
    "source": { "type": "string", "description": "Source document the rules were transcribed from." },
    "licence": {
      "type": "string",
      "minLength": 1,
      "description": "REQUIRED. Licence governing the ruleset content (e.g. 'CC-BY-4.0'), or a statement for proprietary sources."
    },
    "comment": { "type": "string", "description": "Optional free-form note by the ruleset author." },
    "namespace": {
      "type": "string",
      "default": "rpg_os::generated::<ruleset_id>",
      "description": "C++ namespace the code generator emits into."
    },
    "spell_resource": {
      "type": "string",
      "description": "Optional: the resource pool id that casting a spell draws its cost from (e.g. 'AE' for astral energy). When set, the engine's castSpell spends a spell's cost automatically; empty means spells have no resource cost in this ruleset."
    },

    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Short uppercase code, e.g. 'STR', 'COU'." },
          "name": { "type": "string", "description": "Human name used to derive C++ identifiers." },
          "min": { "type": "integer" },
          "max": { "type": "integer" },
          "default": { "type": "integer" }
        }
      }
    },

    "derived_stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "formula"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "formula": {
            "type": "string",
            "description": "Restricted grammar: arithmetic (+ - * / % ^), comparisons, && || !, min/max/floor/ceil/round/clamp, and identifiers (attribute ids, actor.*, target.*, env.*, parameters). Must be translatable to C++ by the code generator."
          }
        }
      }
    },

    "resource_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "max_stat", "min"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "max_stat": { "type": "string", "description": "Stat id whose value forms the pool's maximum." },
          "min": { "type": "integer" }
        }
      }
    },

    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "attributes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "attributes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "default": { "type": "integer" }
        }
      }
    },

    "check_types": {
      "type": "object",
      "description": "Named checks keyed by check type id. Each entry is a generic, data-driven CheckRecipe (see core/checks.hpp): the engine knows no ruleset-specific mechanism, so a new game system is expressed purely as new recipe JSON. The recipe's resolution picks the fundamental shape; the other fields configure dice, comparison, reference source, criticals, grading, and difficulty handling.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "description": "Optional human note (ignored by the engine)." },
          "resolution": {
            "type": "string",
            "enum": ["threshold", "pool", "opposed", "resistance"],
            "description": "threshold: one roll vs one reference. pool: independent rolls whose overshoot draws on a pool. opposed: attacker vs defender contest. resistance: one roll vs a chance derived from two stats."
          },
          "dice": { "type": "string", "description": "Dice expression, e.g. '1d20', '1d100', '3d20'." },
          "comparison": {
            "type": "string",
            "enum": ["ge", "le"],
            "description": "ge: the (bonus-adjusted) roll must be >= the reference (additive checks). le: the roll must be <= the reference (roll-under checks)."
          },
          "threshold_source": {
            "type": "string",
            "enum": ["difficulty", "actor_stat", "target_stat"],
            "description": "Where the reference comes from: the CheckParams difficulty, an actor stat, or a target stat."
          },
          "threshold_stat": { "type": "string", "description": "Stat id used by threshold_source actor_stat/target_stat." },
          "bonus_stats": { "type": "array", "items": { "type": "string" }, "description": "Actor stats added to the rolled total (additive checks)." },
          "pool_attributes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 3, "description": "Pool resolution: the attributes each independent roll is checked against." },
          "pool_stat": { "type": "string", "description": "Pool resolution: the stat providing the pool." },
          "attack_stat": { "type": "string", "description": "Opposed / resistance: the attacker's (active) stat." },
          "parry_stat": { "type": "string", "description": "Opposed / resistance: the defender's (passive) stat." },
          "compare_levels": { "type": "boolean", "description": "Opposed: true compares graded success levels (a hit needs a strictly higher level); false resolves a staged roll-under contest (parry only after a successful attack)." },
          "critical_style": {
            "type": "string",
            "enum": ["none", "face", "double", "percentile"],
            "description": "Critical success detection: face (a specific die face), double (two equal dice), percentile (graded bands), none."
          },
          "critical_face": { "type": "integer", "description": "critical_style face: the die face that is a critical." },
          "critical_confirm": { "type": "boolean", "description": "critical_style face: re-roll to confirm the critical." },
          "fumble_style": {
            "type": "string",
            "enum": ["none", "face", "double", "percentile"],
            "description": "Critical failure detection (same shapes as critical_style)."
          },
          "fumble_face": { "type": "integer", "description": "fumble_style face: the die face that is a fumble." },
          "fumble_confirm": { "type": "boolean", "description": "fumble_style face: re-roll to confirm the fumble." },
          "grading": {
            "type": "string",
            "enum": ["none", "percentile", "pool_quality"],
            "description": "How much information the result carries: none, graded percentile success levels, or a quality level from the remaining pool."
          },
          "difficulty_mode": {
            "type": "string",
            "enum": ["to_threshold", "to_stat"],
            "description": "How CheckParams.difficulty is applied: to_threshold means it IS the reference (a fixed DC); to_stat adds it to the stat forming the reference."
          },
          "difficulty_multiplier": {
            "type": "string",
            "enum": ["none", "double_halve"],
            "description": "Whether Easy / Difficult scales the reference multiplicatively (double_halve)."
          }
        }
      }
    },

    "cost_tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["threshold", "multiplier"] },
          "base_factor": { "type": "number" },
          "thresholds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": { "key": { "type": "number" }, "value": { "type": "number" } }
            }
          }
        }
      }
    },

    "equipment_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      }
    },

    "event_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "actions"],
        "properties": {
          "id": { "type": "string" },
          "trigger": {
            "type": "string",
            "enum": ["on_before_check_roll", "on_after_check_roll", "on_damage_calculated", "on_damage_taken", "on_turn_start", "on_turn_end"]
          },
          "condition": { "type": "string", "description": "Optional formula; empty = always." },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string", "enum": ["modify_event_damage", "consume_resource", "apply_condition"] },
                "amount": { "$ref": "#/definitions/variantValue" },
                "resource": { "type": "string" },
                "condition": { "type": "string" },
                "stacks": { "oneOf": [{ "type": "integer" }, { "type": "string" }], "description": "Stack count, or a formula string evaluated at runtime." },
                "formula": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "data": {
      "type": "object",
      "description": "The data database: archetypes, items, creatures, spells, conditions, poisons, diseases. All numeric values may be ranges.",
      "properties": {
        "archetypes": { "type": "array", "items": { "$ref": "#/definitions/creatureRecord" } },
        "items": { "type": "array", "items": { "$ref": "#/definitions/creatureRecord" } },
        "creatures": { "type": "array", "items": { "$ref": "#/definitions/creatureRecord" } },
        "spells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "level": { "$ref": "#/definitions/variantValue" },
              "school": { "type": "string" },
              "casting_time": { "type": "string" },
              "range": { "type": "string" },
              "duration": { "type": "string" },
              "components": { "type": "string" },
              "damage": { "$ref": "#/definitions/variantValue" },
              "damage_type": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "poisons": { "type": "array", "items": { "$ref": "#/definitions/afflictionRecord" } },
        "diseases": { "type": "array", "items": { "$ref": "#/definitions/afflictionRecord" } },

        "damage_modifier": {
          "type": "array",
          "description": "BRP damage modifier table: STR+SIZ ranges to the damage-modifier dice (e.g. '2 to 12' -> '-1D6').",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "min": { "type": "integer" },
              "max": { "type": "integer" },
              "modifier": { "type": "string" }
            }
          }
        },
        "sorcery_spells": {
          "type": "array",
          "description": "Reference list of sorcery spells from the handout, categorized (Augmentation, Characteristic, Combat, Enhancement, Elemental, Manipulative, Occult, Summoning, Utility), with the level range each spell costs 1 power point per level.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "levels": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "psychic_abilities": {
          "type": "array",
          "description": "Reference list of psychic abilities from the handout; each costs a minimum of 1 power point to use.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "superpowers": {
          "type": "array",
          "description": "Reference list of superpowers from the handout.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "mutations": {
          "type": "array",
          "description": "Random mutation table from the handout (roll D100); adverse mutations are flagged.",
          "items": {
            "type": "object",
            "required": ["roll", "name"],
            "additionalProperties": true,
            "properties": {
              "roll": { "type": "string" },
              "name": { "type": "string" },
              "adverse": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "chaotic_features": {
          "type": "array",
          "description": "Chaotic Features table from the handout: optional features for demons and other creatures of chaos.",
          "items": {
            "type": "object",
            "required": ["roll"],
            "additionalProperties": true,
            "properties": {
              "roll": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "fumble_tables": {
          "type": "object",
          "description": "Combat fumble tables from the handout (natural weapon attack/parry, melee weapon attack/parry, missile weapon attack), keyed by table name.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["roll"],
              "additionalProperties": true,
              "properties": {
                "roll": { "type": "string" },
                "result": { "type": "string" }
              }
            }
          }
        },
        "major_wounds": {
          "type": "array",
          "description": "Major Wound table from the handout; consulted when a character suffers a major wound.",
          "items": {
            "type": "object",
            "required": ["roll"],
            "additionalProperties": true,
            "properties": {
              "roll": { "type": "string" },
              "result": { "type": "string" }
            }
          }
        },
        "personality_traits": {
          "type": "array",
          "description": "Personality trait pairs from the handout; the value of the opposite trait is 100 minus the initial trait.",
          "items": {
            "type": "object",
            "required": ["trait"],
            "additionalProperties": true,
            "properties": {
              "trait": { "type": "string" },
              "opposite": { "type": "string" }
            }
          }
        },
        "reputation": {
          "type": "object",
          "description": "Reputation gains list and observer modifiers from the handout.",
          "additionalProperties": true,
          "properties": {
            "gains": { "type": "array", "items": { "type": "string" } },
            "modifiers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "observer": { "type": "string" },
                  "modifier": { "type": "string" }
                }
              }
            }
          }
        },
        "sanity": {
          "type": "object",
          "description": "Sanity reference tables from the handout: temporary insanity and its duration.",
          "additionalProperties": true,
          "properties": {
            "temporary_insanity": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["roll"],
                "additionalProperties": true,
                "properties": {
                  "roll": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "temporary_insanity_duration": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["roll"],
                "additionalProperties": true,
                "properties": {
                  "roll": { "type": "string" },
                  "duration": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },

  "definitions": {
    "variantValue": {
      "description": "A numeric value that may be a plain integer, a dice expression string, or an explicit range object.",
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^[+-]?([0-9]+d[0-9]+|[0-9]+)([+-][0-9]+d[0-9]+|[+-][0-9]+)*$" },
        {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
        }
      ]
    },
    "creatureRecord": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "type": { "type": "string" },
        "ac": { "$ref": "#/definitions/variantValue" },
        "speed": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/definitions/variantValue" } },
        "skills": { "type": "object", "additionalProperties": { "$ref": "#/definitions/variantValue" } },
        "resources": { "type": "object", "additionalProperties": { "$ref": "#/definitions/variantValue" } },
        "conditions": { "type": "object", "additionalProperties": { "type": "integer" } },
        "attacks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "to_hit": { "$ref": "#/definitions/variantValue" },
              "damage": { "$ref": "#/definitions/variantValue" },
              "damage_type": { "type": "string" }
            }
          }
        },
        "traits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "afflictionRecord": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "price": { "oneOf": [{ "type": "string" }, { "type": "number" }], "description": "Cost of a single dose, e.g. '150 GP'." },
        "onset": { "type": "string" },
        "save": { "type": "string" },
        "duration": { "type": "string" },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stat": { "type": "string", "description": "The stat, resource pool, or condition id this effect acts on. A resource pool id damages that pool; a condition id (or the explicit 'condition' field) applies condition stacks; any other stat id is reduced by amount." },
              "amount": { "$ref": "#/definitions/variantValue" },
              "condition": { "type": "string", "description": "When stat is not itself a condition id, the condition id to apply (amount = stacks)." },
              "description": { "type": "string" }
            }
          }
        },
        "description": { "type": "string" }
      }
    }
  }
}
