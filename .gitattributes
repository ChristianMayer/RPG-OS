# Normalise line endings: LF everywhere, no autocrlf surprises.
* text=auto eol=lf

*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files must not be normalised.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
